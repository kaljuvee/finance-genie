# ============================================================================
# Finance Genie - Environment Configuration
# ============================================================================
# This file contains all required environment variables for Finance Genie.
# Update these values with your actual API keys and database credentials.
# IMPORTANT: Never commit this file to version control!
# ============================================================================

# ============================================================================
# API KEYS - REQUIRED
# ============================================================================

# Google Gemini API Key
# Get your key from: https://ai.google.dev/
# Used for LLM reasoning and decision making
GOOGLE_API_KEY=AIzaSyDuSND45JlAKVQ7ivY9gqZT7Z9gvrn-i70

# Tavily Search API Key
# Get your key from: https://tavily.com/
# Used for trading news and market analysis search
TAVILY_API_KEY=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

# EODHD Stock Data API Key
# Get your key from: https://eodhd.com/
# Used for OHLCV data and technical indicators
EODHD_API_KEY=6450f2e5630b53.53578730

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Connection String with pgvector support
# Format: postgresql://username:password@host:port/database
PGVECTOR_CONNECTION=postgresql://indurent_db_user:mORTX4lmewn7ZJsMiU7Ox7Qb8gnxPRgf@dpg-d40gneur433s738clpeg-a.frankfurt-postgres.render.com/indurent_db

# Database Schema Name
DB_SCHEMA=genie

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# ============================================================================
# STREAMLIT CONFIGURATION
# ============================================================================

# Streamlit Page Configuration
STREAMLIT_CLIENT_LOGGER_LEVEL=info
STREAMLIT_CLIENT_SHOW_ERROR_DETAILS=true

# Streamlit Server Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_RUN_ON_SAVE=true

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Application Environment (development, staging, production)
ENV=development

# Debug Mode (true/false)
DEBUG=true

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# TRADING AGENT SETTINGS
# ============================================================================

# LLM Model Configuration
GEMINI_MODEL=gemini-2.5-flash

# Historical Data Period (days)
HISTORICAL_DAYS=120

# Embedding Model Configuration
EMBEDDING_MODEL=text-embedding-004

# Embedding Dimension
EMBEDDING_DIMENSION=768

# ============================================================================
# DECISION THRESHOLDS
# ============================================================================

# BUY Signal Threshold (%)
BUY_THRESHOLD=2.0

# SELL Signal Threshold (%)
SELL_THRESHOLD=-2.0

# Downside Risk Threshold (%)
DOWNSIDE_RISK_THRESHOLD=-5.0

# ============================================================================
# BATCH PROCESSING SETTINGS
# ============================================================================

# Maximum symbols per batch
MAX_BATCH_SIZE=50

# Timeout per symbol (seconds)
SYMBOL_TIMEOUT=60

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# API Rate Limiting (requests per minute)
API_RATE_LIMIT=60

# Request Timeout (seconds)
REQUEST_TIMEOUT=30

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log File Path
LOG_FILE_PATH=logs/finance_genie.log

# Log File Max Size (MB)
LOG_MAX_SIZE=10

# Log File Backup Count
LOG_BACKUP_COUNT=5

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable Vector Store (requires PostgreSQL with pgvector)
ENABLE_VECTOR_STORE=true

# Enable Database Persistence
ENABLE_DB_PERSISTENCE=true

# Enable Performance Metrics Tracking
ENABLE_METRICS=true

# Enable Caching
ENABLE_CACHE=true

# Cache TTL in seconds (1 hour)
CACHE_TTL=3600

# ============================================================================
# ALPACA TRADING (Optional - for future integration)
# ============================================================================

# Alpaca Paper Trading API Keys (optional)
ALPACA_PAPER_API_KEY=PKWSHV3AS4J71TGOQEOC
ALPACA_PAPER_SECRET_KEY=wffi5PYdLHI2N/6Kfqx6LBTuVlfURGgOp9u5mXo5

# ============================================================================
# NOTES
# ============================================================================
# 1. API Keys are REQUIRED for the application to function
# 2. Database configuration is OPTIONAL (demo mode without database)
# 3. Never commit this file with real API keys to version control
# 4. Use .env.sample as a template for new deployments
# 5. Ensure all values are properly quoted if they contain special characters
# 6. For production, use strong database passwords and secure API keys
# 7. Keep this file secure and never share API keys
# ============================================================================
