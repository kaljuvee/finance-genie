# ============================================================================
# Finance Genie - Extended Environment Configuration Template
# ============================================================================
# This is a TEMPLATE file showing all available configuration options.
# Copy this file to .env and update with your actual values.
# IMPORTANT: Never commit .env with real API keys to version control!
# ============================================================================

# ============================================================================
# API KEYS - REQUIRED
# ============================================================================

# Google Gemini API Key
# Get your key from: https://ai.google.dev/
# Used for LLM reasoning and decision making
GOOGLE_API_KEY=your_gemini_api_key_here

# Tavily Search API Key
# Get your key from: https://tavily.com/
# Used for trading news and market analysis search
TAVILY_API_KEY=your_tavily_api_key_here

# EODHD Stock Data API Key
# Get your key from: https://eodhd.com/
# Used for OHLCV data and technical indicators
EODHD_API_KEY=your_eodhd_api_key_here

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Connection String with pgvector support
# Format: postgresql://username:password@host:port/database
# Example: postgresql://postgres:password@localhost:5432/genie
# Leave empty to run in demo mode without database persistence
PGVECTOR_CONNECTION=postgresql://username:password@localhost:5432/genie

# Database Schema Name
# Default: genie
DB_SCHEMA=genie

# Database Connection Pool Settings
# Number of connections to maintain in the pool
DB_POOL_SIZE=5

# Maximum overflow connections beyond pool size
DB_MAX_OVERFLOW=10

# Connection pool recycle time in seconds (1 hour)
DB_POOL_RECYCLE=3600

# ============================================================================
# STREAMLIT CONFIGURATION
# ============================================================================

# Streamlit Page Configuration
STREAMLIT_CLIENT_LOGGER_LEVEL=info
STREAMLIT_CLIENT_SHOW_ERROR_DETAILS=true

# Streamlit Server Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_RUN_ON_SAVE=true

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Application Environment (development, staging, production)
ENV=development

# Debug Mode (true/false)
DEBUG=true

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# TRADING AGENT SETTINGS
# ============================================================================

# LLM Model Configuration
# Available models: gemini-2.5-flash, gemini-1.5-pro, etc.
GEMINI_MODEL=gemini-2.5-flash

# Historical Data Period (days)
# Number of days of historical data to fetch for analysis
HISTORICAL_DAYS=120

# Embedding Model Configuration
# Model to use for vector embeddings
EMBEDDING_MODEL=text-embedding-004

# Embedding Dimension
# Vector dimension for embeddings (Gemini uses 768)
EMBEDDING_DIMENSION=768

# ============================================================================
# DECISION THRESHOLDS
# ============================================================================

# BUY Signal Threshold (%)
# Minimum median return to trigger BUY signal
BUY_THRESHOLD=2.0

# SELL Signal Threshold (%)
# Maximum median return to trigger SELL signal (negative value)
SELL_THRESHOLD=-2.0

# Downside Risk Threshold (%)
# Maximum acceptable downside risk (Q25)
DOWNSIDE_RISK_THRESHOLD=-5.0

# ============================================================================
# BATCH PROCESSING SETTINGS
# ============================================================================

# Maximum symbols per batch
MAX_BATCH_SIZE=50

# Timeout per symbol (seconds)
SYMBOL_TIMEOUT=60

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# API Rate Limiting (requests per minute)
API_RATE_LIMIT=60

# Request Timeout (seconds)
REQUEST_TIMEOUT=30

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log File Path
LOG_FILE_PATH=logs/finance_genie.log

# Log File Max Size (MB)
LOG_MAX_SIZE=10

# Log File Backup Count
LOG_BACKUP_COUNT=5

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable Vector Store (requires PostgreSQL with pgvector)
ENABLE_VECTOR_STORE=true

# Enable Database Persistence
ENABLE_DB_PERSISTENCE=true

# Enable Performance Metrics Tracking
ENABLE_METRICS=true

# Enable Caching
ENABLE_CACHE=true

# Cache TTL in seconds (1 hour)
CACHE_TTL=3600

# ============================================================================
# ALPACA TRADING (Optional - for future integration)
# ============================================================================

# Alpaca Paper Trading API Keys (optional)
# Get your keys from: https://alpaca.markets/
ALPACA_PAPER_API_KEY=your_alpaca_api_key_here
ALPACA_PAPER_SECRET_KEY=your_alpaca_secret_key_here

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
# 1. Copy this file to .env:
#    cp .env.sample.extended .env
#
# 2. Update all API keys with your actual values:
#    - GOOGLE_API_KEY: Get from https://ai.google.dev/
#    - TAVILY_API_KEY: Get from https://tavily.com/
#    - EODHD_API_KEY: Get from https://eodhd.com/
#
# 3. (Optional) Configure database connection:
#    - PGVECTOR_CONNECTION: PostgreSQL with pgvector
#    - Leave empty for demo mode
#
# 4. Run the application:
#    streamlit run Home.py
#
# 5. Or run CLI:
#    python cli.py --test
#    python cli.py --status
#    python cli.py --symbol NVDA
#
# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. NEVER commit .env with real API keys to version control
# 2. Always use .env.sample.extended as a template
# 3. Keep API keys secure and rotate them regularly
# 4. Use strong database passwords in production
# 5. Enable HTTPS in production environments
# 6. Implement rate limiting for API endpoints
# 7. Use environment-specific configurations
# 8. Review logs regularly for suspicious activity
#
# ============================================================================
# TROUBLESHOOTING
# ============================================================================
# If you get API key errors:
# - Verify all required API keys are set in .env
# - Check API key validity and rate limits
# - Ensure environment variables are loaded
#
# If you get database errors:
# - Ensure PostgreSQL is running
# - Check PGVECTOR_CONNECTION string format
# - Verify database and schema exist
# - Run: python -c "from utils.db_util import init_db; init_db()"
#
# If you get import errors:
# - Reinstall dependencies: pip install -r requirements.txt
# - Check Python version: python --version (should be 3.11+)
# - Verify all packages are installed: pip list
#
# ============================================================================
