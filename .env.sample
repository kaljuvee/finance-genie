# Finance Genie Environment Configuration
# Copy this file to .env and fill in your actual credentials

# ===== REQUIRED API KEYS =====

# Google Gemini API Key
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Gemini Model (configurable)
# Options: gemini-2.5-flash, gemini-2.0-flash-exp, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Tavily Search API Key
# Get from: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# EODHD Stock Data API Key
# Get from: https://eodhd.com
EODHD_API_KEY=your_eodhd_api_key_here

# ===== DATABASE CONFIGURATION =====

# PostgreSQL Connection String with pgvector
# Format: postgresql://user:password@host:port/database
# Schema: genie (created automatically)
PGVECTOR_CONNECTION=postgresql://user:password@localhost:5432/finance_genie

# Database Schema Name
DB_SCHEMA=genie

# ===== OPTIONAL: TRADING EXECUTION =====

# Alpaca Paper Trading API Key
# Get from: https://app.alpaca.markets
ALPACA_PAPER_API_KEY=your_alpaca_api_key_here

# Alpaca Paper Trading Secret Key
ALPACA_PAPER_SECRET_KEY=your_alpaca_secret_key_here

# ===== OPTIONAL: ADVANCED CONFIGURATION =====

# Agent Temperature (0.0-1.0)
# Lower = more deterministic, Higher = more creative
AGENT_TEMPERATURE=0.15

# Vector Store Distance Strategy
# Options: cosine, euclidean, inner_product
VECTOR_DISTANCE_STRATEGY=cosine

# Max Results for Web Search
TAVILY_MAX_RESULTS=5

# OHLCV History Length (days)
OHLCV_HISTORY_LENGTH=120

# Technical Indicator Periods
SMA_PERIOD=20
RSI_PERIOD=14

# Decision Thresholds
BUY_THRESHOLD=2.0
SELL_THRESHOLD=-2.0

# ===== LOGGING =====

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log File Path (optional)
LOG_FILE=logs/finance_genie.log
